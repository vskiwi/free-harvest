# LilyGo T-Dongle-S3 - overlay applied on top of sdkconfig.defaults.
#
#   idf.py -B build-tdongle -D SDKCONFIG=build-tdongle/sdkconfig \
#       -D SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.defaults.t-dongle-s3" \
#       set-target esp32s3 build
#
# (-D SDKCONFIG keeps this board's generated sdkconfig inside its build
# directory; without it, idf.py writes ./sdkconfig and the next generic
# build in ./build silently picks up the dongle configuration.)
#
# Board: bare ESP32-S3 with 16 MB Quad-SPI flash (W25Q128), NO PSRAM, an
# 80x160 ST7735 LCD, one APA102 RGB LED and one button, all inside a USB-A
# stick. Pins are in main/board_t_dongle_s3.h.
#
# Console. The board has ONE USB connector and the ESP32-S3 has ONE USB PHY.
# This firmware hands the PHY to TinyUSB so the dryer can enumerate us as a
# CDC device, which means USB-Serial/JTAG is gone the moment the app starts:
# `idf.py monitor` over the stick's own plug cannot work, and the secondary
# USB_SERIAL_JTAG console must be disabled so its driver does not touch the
# PHY registers while TinyUSB owns them. UART0 (GPIO43 TX / GPIO44 RX,
# 115200) is the only real console; it is exposed on the 4-pin JST-SH
# "QWIIC" connector of the 2023+ revision only. Without it, logs are at
# http://<ip>/api/log.
#
# Flashing. The ROM bootloader still talks USB-Serial/JTAG regardless of the
# app: hold the BOOT button while plugging the stick into the computer, then
#   idf.py -B build-tdongle -p /dev/cu.usbmodem* flash
# Every later update can go over Wi-Fi (Settings -> Update).

# --- Flash: 16 MB W25Q128, QIO at 80 MHz (the vendor's own board file).
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions-16mb.csv"

# PSRAM: the plain T-Dongle-S3 has none. Do NOT set CONFIG_SPIRAM here; the
# frame buffer (25.6 KB) lives in internal RAM.

# --- RAM budget. Everything below buys DRAM back; nothing here changes what
# the firmware does.
#
# The ESP32-S3 has 512 KB of SRAM, of which the app can use about 340 KB
# for code-in-RAM + static data + heap (the rest is cache and ROM reserve).
# Upstream's generic build already places ~260 KB of that statically; this
# board adds a 25.6 KB frame buffer and the LCD/LED drivers, and the field
# result was 25 KB of heap after Wi-Fi came up, falling to 14 KB once MQTT
# and a browser joined - at which point Wi-Fi/lwIP start failing
# allocations and the link flaps. Measured on this build:
#
#   -Os instead of -Og ............................ ~12 KB of IRAM code
#   Wi-Fi code out of IRAM (IRAM_OPT, RX_IRAM_OPT) ~37 KB of IRAM code
#   FreeRTOS/heap/ringbuf/PHY/SPI-ISR into flash .. ~10 KB of IRAM code
#   smaller Wi-Fi buffer pools .................... ~20 KB of heap at run time
#   no IPv6 ....................................... ~3 KB of heap + code
#
# IRAM-resident code and DRAM share the same SRAM on this chip, so every
# KB of code moved to flash is a KB of heap. The cost is Wi-Fi throughput
# (irrelevant: the dryer emits a frame every few seconds and the web UI is
# a single page) and slightly slower response while SPIFFS writes disable
# the cache for a few ms.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_ESP_PHY_IRAM_OPT=n
# (FreeRTOS and ringbuf are in flash by default since IDF 6.) Heap functions
# to flash as well; that also moves the SPI master ISR (LCD DMA) out of
# IRAM, which IDF requires when the heap is not IRAM-resident.
CONFIG_HEAP_PLACE_FUNCTION_INTO_FLASH=y
# Wi-Fi buffer pools: the defaults (10 static RX, 32/32 dynamic, BA window
# 6) are sized for streaming. Halved; the BA windows follow the IDF
# guidance of "at most half the buffer count".
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_RX_BA_WIN=4
CONFIG_ESP_WIFI_TX_BA_WIN=4
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=16
# Features the firmware cannot use: it only ever joins an SSID+passphrase
# network and only ever speaks plain mqtt://.
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n
CONFIG_ESP_WIFI_SOFTAP_SAE_SUPPORT=n
CONFIG_ESP_WIFI_ENABLE_WPA3_OWE_STA=n
CONFIG_LWIP_IPV6=n
CONFIG_LWIP_DNS_SUPPORT_MDNS_QUERIES=n
CONFIG_MQTT_TRANSPORT_WEBSOCKET=n
# In-app log ring: 24 KB packed still holds ~370 lines (was 55 KB for 384).
CONFIG_HR_LOG_RING_KB=24
# Batch history (the dryer's own CSV logs over FDFILES / FILEREAD): on from
# the first boot on this board - confirmed live 2026-09-17 (docs/30). Reads
# still refuse to run during a batch unless asked with force=1.
CONFIG_HR_BATCH_HISTORY_DEFAULT_ON=y
# Two FILEREADs in flight: measured live on 6.0.644170 (docs/30 §7.2) as
# ~16 % faster than strict request-reply with no lost or duplicated blocks;
# three was slower again. Overridable at runtime (POST /api/dryer/files/tune).
CONFIG_HR_FILES_PIPELINE_DEPTH=2

# --- Console: UART0 only, no USB-Serial/JTAG secondary (see above).
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# --- Board peripherals.
CONFIG_HR_BOARD_T_DONGLE_S3=y
CONFIG_HR_DISPLAY=y
CONFIG_HR_LED=y
CONFIG_HR_BUTTON=y
# The dryer's USB port is on its right side, so the stick hangs plug-right:
# rotate 180 degrees from the vendor's plug-left orientation.
CONFIG_HR_DISPLAY_ROTATE_180=y
# Backlight: full for 30 s after an event, 10 % until 5 min, then off. An
# unacknowledged alert and the open setup AP keep it readable.
CONFIG_HR_DISPLAY_AUTO_DIM=y
CONFIG_HR_DISPLAY_DIM_S=30
CONFIG_HR_DISPLAY_OFF_S=300
CONFIG_HR_DISPLAY_DIM_PCT=10
CONFIG_HR_DISPLAY_ALERT_KEEP_ON=y
CONFIG_HR_LED_DIM_WITH_DISPLAY=y
